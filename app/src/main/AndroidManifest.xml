<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Localisation approximative : suffisante pour le calcul du ciel (cahier des charges §5 et §8). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Caméra : demandée uniquement quand l'utilisateur active le fond caméra. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Retour haptique quand l'objet recherché est centré. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Aucune permission INTERNET : l'application est 100 % hors-ligne et vérifiable. -->

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.compass" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.gyroscope" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:glEsVersion="0x00020000" android:required="true" />

    <application
        android:name=".CarteDuCielApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.CarteDuCiel"
        tools:targetApi="33">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true"
            android:screenOrientation="fullUser"
            android:theme="@style/Theme.CarteDuCiel">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Mémorisation de la langue choisie dans l'application (AppCompat, API < 33). -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data android:name="autoStoreLocales" android:value="true" />
        </service>
    </application>
</manifest>
