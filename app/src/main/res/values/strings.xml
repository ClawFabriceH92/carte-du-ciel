    <!-- À propos -->
    <string name="about_title">À propos</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_intro">Carte du ciel en réalité augmentée. Application hors-ligne, sans compte, sans publicité ni accès réseau. Le ciel est calculé, pas filmé.</string>
    <string name="about_data_title">Données et bibliothèques</string>
    <string name="about_hyg">Étoiles : base HYG v4.1, David Nash (astronexus.com), licence CC BY-SA 4.0. Le fichier d\'étoiles dérivé embarqué dans l\'application est diffusé sous la même licence.</string>
    <string name="about_d3">Figures et noms des constellations : d3-celestial, Olaf Frohn, licence BSD 3-Clause.</string>
    <string name="about_ae">Calculs astronomiques : Astronomy Engine, Don Cross, licence MIT.</string>
    <string name="about_wmm">Déclinaison magnétique : World Magnetic Model 2025, NOAA/NCEI et British Geological Survey, domaine public.</string>
    <string name="about_iau">Noms propres d\'étoiles : Union astronomique internationale (groupe de travail WGSN), via la base HYG.</string>
    <string name="about_licenses_title">Textes des licences</string>
    <string name="about_privacy_title">Confidentialité</string>
    <string name="about_privacy">Aucune donnée ne quitte le téléphone. L\'application ne demande pas la permission Internet : vous pouvez le vérifier dans les informations de l\'application.</string>
    <string name="about_accuracy_title">Précision</string>
    <string name="about_accuracy">Positions calculées à mieux d\'une minute d\'arc (Astronomy Engine). La précision ressentie dépend surtout de la boussole du téléphone : utilisez l\'indicateur de précision, la calibration en « 8 » et le calage sur une étoile connue.</string>
