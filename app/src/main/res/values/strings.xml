<resources>
    <string name="app_name">Carte du ciel</string>

    <!-- Accueil -->
    <string name="onboarding_title">Une fenêtre sur le ciel</string>
    <string name="onboarding_principle">Levez le téléphone : l\'écran montre les étoiles, constellations et planètes situées derrière l\'appareil, calculées à partir de votre position, de l\'heure et de l\'orientation du téléphone. Le ciel n\'est pas filmé mais calculé : cela fonctionne aussi de jour, en intérieur ou par temps couvert.</string>
    <string name="onboarding_location_title">Où êtes-vous ?</string>
    <string name="onboarding_location_text">La position approximative (à un kilomètre près) suffit pour calculer le ciel. Rien ne quitte votre téléphone : l\'application n\'a pas d\'accès à Internet.</string>
    <string name="onboarding_location_allow">Utiliser ma position</string>
    <string name="onboarding_location_manual">Choisir une ville</string>
    <string name="onboarding_compass_title">Calibrer la boussole</string>
    <string name="onboarding_compass_text">Décrivez lentement un « 8 » dans l\'air avec le téléphone, en le tournant dans tous les sens, jusqu\'à ce que l\'indicateur de précision passe au vert. Éloignez-vous des objets métalliques et des aimants (coques, voitures).</string>
    <string name="onboarding_no_sensor">Ce téléphone n\'a pas de capteur d\'orientation exploitable : la carte s\'utilise au doigt (glisser pour tourner, pincer pour zoomer).</string>
