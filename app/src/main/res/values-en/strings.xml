    <string name="app_name">Sky Map</string>

    <string name="onboarding_title">A window onto the sky</string>
    <string name="onboarding_principle">Raise your phone: the screen shows the stars, constellations and planets behind the device, computed from your location, the time and the phone\'s orientation. The sky is not filmed but computed, so it also works in daylight, indoors or under clouds.</string>
    <string name="onboarding_location_title">Where are you?</string>
    <string name="onboarding_location_text">An approximate location (within a kilometre) is enough to compute the sky. Nothing leaves your phone: the app has no Internet access.</string>
    <string name="onboarding_location_allow">Use my location</string>
    <string name="onboarding_location_manual">Pick a city</string>
    <string name="onboarding_compass_title">Calibrate the compass</string>
    <string name="onboarding_compass_text">Slowly draw a figure 8 in the air with the phone, turning it in every direction, until the accuracy indicator turns green. Keep away from metal objects and magnets (cases, cars).</string>
    <string name="onboarding_no_sensor">This phone has no usable orientation sensor: drag to pan and pinch to zoom the map.</string>
