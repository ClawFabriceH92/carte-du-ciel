    <string name="about_title">About</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_intro">Augmented-reality sky map. Offline, no account, no ads, no network access. The sky is computed, not filmed.</string>
    <string name="about_data_title">Data and libraries</string>
    <string name="about_hyg">Stars: HYG database v4.1, David Nash (astronexus.com), CC BY-SA 4.0 licence. The derived star file embedded in the app is distributed under the same licence.</string>
    <string name="about_d3">Constellation figures and names: d3-celestial, Olaf Frohn, BSD 3-Clause licence.</string>
    <string name="about_ae">Astronomical computations: Astronomy Engine, Don Cross, MIT licence.</string>
    <string name="about_wmm">Magnetic declination: World Magnetic Model 2025, NOAA/NCEI and British Geological Survey, public domain.</string>
    <string name="about_iau">Star proper names: International Astronomical Union (WGSN working group), via the HYG database.</string>
    <string name="about_licenses_title">Licence texts</string>
    <string name="about_privacy_title">Privacy</string>
    <string name="about_privacy">No data leaves the phone. The app does not request the Internet permission: you can check this in the app information.</string>
    <string name="about_accuracy_title">Accuracy</string>
    <string name="about_accuracy">Positions are computed to better than one arcminute (Astronomy Engine). Perceived accuracy depends mostly on the phone\'s compass: use the accuracy indicator, the figure-8 calibration and the alignment on a known star.</string>
</resources>
